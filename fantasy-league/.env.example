# ---- Public (shipped to the browser) ----
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---- Server only (Vercel serverless functions). Never expose these. ----
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Shared secret stored in the ffl_server_secret table; lets api/ call the ffl_server_* functions.
FFL_SERVER_SECRET=
ANTHROPIC_API_KEY=sk-ant-...
YAHOO_CLIENT_ID=your-yahoo-app-client-id
YAHOO_CLIENT_SECRET=your-yahoo-app-client-secret
# Optional: pin the league instead of auto-discovering it after Connect Yahoo.
# Format: nfl.l.123456
YAHOO_LEAGUE_KEY=
# Optional: only needed if the site runs on a domain other than the one Yahoo redirects to.
YAHOO_REDIRECT_URI=
# Protects the weekly cron that writes an automatic burn. Any long random string.
CRON_SECRET=
